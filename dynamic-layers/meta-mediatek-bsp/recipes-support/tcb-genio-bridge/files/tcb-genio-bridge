#!/usr/bin/env bash
# tcb-genio-bridge - apply a torizoncore-builder rootfs customisation to a
# MediaTek genio-flash image and repack it for genio-flash.
#
# torizoncore-builder's raw-image path needs a raw WIC, but the Genio target is
# delivered as aiotflash.tar wrapping an Android-sparse WIC. This unwraps the
# tarball, unsparses the system image, runs tcb, re-sparses with the build's
# 4096-byte block size, and repacks the tarball with only the rootfs changed.
set -euo pipefail

prog=${0##*/}
here=$(cd -- "$(dirname -- "$0")" && pwd)
# Quoted for the diagnostics to print back, so a failing run tells the user
# exactly what to re-run rather than "the same arguments as before".
invocation=$(printf '%q ' "$0" "$@")

die()  { echo "$prog: error: $*" >&2; exit 1; }
note() { echo "$prog: $*"; }

usage() {
    cat <<EOF
Usage: $prog [-o OUTPUT_TAR] [-f TCBUILD_YAML] [-c CHANGES_DIR]... [-b COMPOSE_FILE]
             [-e VAR]... INPUT_TAR [-- TCB_BUILD_ARG...]

Apply a torizoncore-builder rootfs customisation to a genio-flash image.

  INPUT_TAR        aiotflash.tar produced by the Yocto build (deploy dir)
  -o OUTPUT_TAR    repacked tarball (default: <INPUT_TAR without .tar>-custom.tar)
  -f TCBUILD_YAML  tcbuild config (default: tcbuild-genio.yaml beside this script)
  -c CHANGES_DIR   directory of files to overlay onto the rootfs. Repeatable;
                   each directory is staged under its own basename and is listed
                   in the config's customization.filesystem by that name, so the
                   basename must be letters, digits, '.', '_' or '-', and must
                   not begin with '-' (default: ./changes if present).
  -b COMPOSE_FILE  docker-compose file for the container-preload (bundle)
                   customisation (default: ./docker-compose.yml if present).
                   Its basename must match the tcbuild config's
                   bundle.compose-file (default docker-compose.yml).
  -e VAR           forward VAR's value from the environment to the config's
                   \${VAR} substitution, as --set VAR=<value>. Repeatable. VAR
                   must be exported (a plain shell assignment is not enough);
                   exported-but-empty forwards an empty value.

Everything after -- is appended to the torizoncore-builder build invocation,
e.g. -- --set PASSWORD=secret. Any option of that command is forwarded, not just
--set. -e assignments are placed first, so an explicit --set after -- overrides
an -e of the same variable.

Secrets: torizoncore-builder takes substitution values only via --set, which
places them in the process argument list, where they are visible in host 'ps'
output and in 'docker inspect' of the tcb container. Passing -e VAR rather than
-- --set VAR=... keeps the secret out of shell history, terminal scrollback and
CI logs, but it does not remove that argument-list exposure.

Requires Docker (runs torizoncore-builder from its container image) and
simg2img/img2simg (android-sdk-libsparse-utils).
EOF
}

out=""; yaml="$here/tcbuild-genio.yaml"; compose=""; yaml_default=1
changes_dirs=(); env_vars=()
while getopts ":o:f:c:b:e:h" opt; do
    case $opt in
        o) out=$OPTARG ;;
        f) yaml=$OPTARG; yaml_default=0 ;;
        c) changes_dirs+=("$OPTARG") ;;
        b) compose=$OPTARG ;;
        e) env_vars+=("$OPTARG") ;;
        h) usage; exit 0 ;;
        :) die "option -$OPTARG requires an argument" ;;
        \?) die "unknown option -$OPTARG" ;;
    esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || { usage >&2; die "exactly one INPUT_TAR is required"; }
in_tar=$1; shift
# Trailing tcb arguments must be introduced by --, so a stray second operand
# stays a bridge diagnostic instead of reaching tcb as a stray build argument.
if [ $# -gt 0 ]; then
    [ "$1" = "--" ] \
        || { usage >&2; die "unexpected operand '$1': torizoncore-builder build arguments must follow --"; }
    shift
fi
tcb_args=("$@")

# torizoncore-builder runs from its official container image, so users install
# nothing beyond Docker. $TCB_IMAGE overrides the image tag.
TCB_IMAGE=${TCB_IMAGE:-torizon/torizoncore-builder:3}
LAUNCHER_NAME=.tcb-genio-launch.py

# Everything the tool does with the user's files happens through one bind mount,
# so the daemon must be able to resolve the working directory. A daemon that
# cannot — snap-packaged Docker (private /tmp, reaches only non-hidden files
# under $HOME), a remote DOCKER_HOST, this script run inside a container — is
# given an empty directory by Docker instead of an error, and every later step
# fails for reasons that have nothing to do with the real cause. These five
# messages are the whole user-facing contract of that failure.
msg_A() {
    cat >&2 <<EOF
$prog: error: the Docker daemon cannot see this machine's files.

  working directory: $work
  what happened:     the file this script just wrote was not there when the
                     container looked for it

The Docker daemon does not share the filesystem you are running from. This is
normal for Docker installed as a snap, which has its own private /tmp and can
only reach non-hidden files under your home directory.

EOF
    case ${DOCKER_HOST-} in
        ''|unix://*) cat >&2 <<EOF
Move the whole working directory somewhere under your home and run it again
from there - the script, its tcbuild-genio.yaml, your changes/ directory, any
docker-compose.yml and the .aiotflash.tar all need to travel together:

  mkdir -p ~/tcb-work
  cp -a "$PWD/." ~/tcb-work/
  cd ~/tcb-work
  $invocation

(that last line is the command you just ran)

If you used sudo, run it without: under sudo your home is /root, which a
snap-installed Docker cannot reach either. And if "docker context ls" shows
something other than 'default' in use, your daemon may not be on this machine
at all.
EOF
            ;;
        *) cat >&2 <<EOF
DOCKER_HOST is set to $DOCKER_HOST, so the Docker daemon is on another machine
and cannot read any directory on this one. No directory here will work. Point
Docker at a local daemon and run it again:

  unset DOCKER_HOST
  $invocation
EOF
            ;;
    esac
    printf '\n%s\n' "To skip this check and run anyway, set TCB_GENIO_SKIP_PREFLIGHT=1." >&2
}

msg_B() {
    cat >&2 <<EOF
$prog: error: the Docker daemon reached the working directory but could not
use it.

  working directory: $work
  what happened:     $1

If this directory is on a network share (NFS, CIFS) or a read-only mount, use
a local one instead:

  mkdir -p ~/tcb-work && cp -a "$PWD/." ~/tcb-work/ && cd ~/tcb-work

Otherwise the daemon itself is restricting access - dockerd running with
--userns-remap, or SELinux in enforcing mode. Those are host configuration and
moving the directory will not help.

To skip this check and run anyway, set TCB_GENIO_SKIP_PREFLIGHT=1.
EOF
}

msg_C() {
    cat >&2 <<EOF
$prog: error: the Docker socket did not reach the container.

  socket: $sock

Preloading containers needs the bridge to hand the daemon's own socket to
torizoncore-builder. If you are running rootless Docker, its socket is
elsewhere - tell the bridge where:

  DOCKER_HOST=unix:///run/user/\$(id -u)/docker.sock $invocation

If your daemon listens only on a TCP port and has no unix socket at all,
container preloading cannot work through this bridge; build without the
bundle: block in the tcbuild configuration.
EOF
}

msg_D() {
    cat >&2 <<EOF
$prog: error: could not run a container. Docker reported:

  ${1:-(no output)}

If that mentions "permission denied" and "docker.sock", your user is not in the
docker group:

  sudo usermod -aG docker \$USER

then start a new login session (log out and back in, not just a new terminal)
and run it again.
EOF
}

msg_E() {
    cat >&2 <<EOF
$prog: warning: only $(kb_gb "$1") free where the working files go; this
customisation needs roughly $(kb_gb "$2"). The run will continue and may fail
part way.

  working directory: $work

To use a different disk, set TMPDIR to a directory on it - it must be one the
Docker daemon can also reach, so with snap-installed Docker keep it under your
home:

  TMPDIR=~/big-disk/scratch $invocation
EOF
}

kb_gb() { awk -v k="$1" 'BEGIN { printf "%.1f GB", k / 1000000 }'; }

# One throwaway container, before the minutes of unpacking that a bad mount
# would waste. The probe is a shell script so there is no format to agree on
# between it and the caller; it always exits 0 and reports three facts, so a
# non-zero docker run means the container never ran, not that a check failed.
probe_workdir() {
    local out err nonce
    mkdir -p "$work/tcb"
    nonce=$$-${RANDOM}-$(date +%s)
    printf %s "$nonce" > "$work/tcb/.tcb-probe-host"
    err=$(mktemp "$work/probe-err.XXXXXX")

    out=$(docker run --rm ${dind_args[@]+"${dind_args[@]}"} \
              -v "$work/tcb":/workdir --entrypoint sh "$TCB_IMAGE" -c '
                  echo READY
                  if   [ ! -e /workdir/.tcb-probe-host ]; then echo "READ=absent"
                  elif [ ! -r /workdir/.tcb-probe-host ]; then echo "READ=denied"
                  else echo "READ=$(cat /workdir/.tcb-probe-host)"; fi
                  if echo back > /workdir/.tcb-probe-ctr 2>/dev/null
                  then echo "WRITE=ok"; else echo "WRITE=denied"; fi
                  if [ -S /var/run/docker.sock ]
                  then echo "SOCK=ok"; else echo "SOCK=bad"; fi
              ' 2>"$err") || true

    case $out in
        READY*) ;;
        *) msg_D "$(cat "$err")"; return 1 ;;
    esac
    case $out in
        *"READ=$nonce"*) ;;
        *READ=absent*) msg_A; return 1 ;;
        *) msg_B "could not read the file this machine wrote"; return 1 ;;
    esac
    case $out in
        *WRITE=ok*) ;;
        *) msg_B "could not write into the working directory"; return 1 ;;
    esac
    [ "$(cat "$work/tcb/.tcb-probe-ctr" 2>/dev/null)" = back ] \
        || { msg_B "what the container wrote did not reach this machine"; return 1; }
    if [ "$bundle_configured" = 1 ]; then
        case $out in
            *SOCK=ok*) ;;
            *) msg_C; return 1 ;;
        esac
    fi
    rm -f "$work/tcb/.tcb-probe-host" "$work/tcb/.tcb-probe-ctr" "$err"
}

# Run tcb in the given host workdir (mounted as tcb's /workdir) from a launcher
# that patches it for the Genio's 4096-byte-sector WIC (see below).
run_tcb() {
    local workdir=$1; shift
    # Stock tcb's raw-image path assumes 512-byte sectors end to end; the Genio
    # UFS WIC is 4096-byte-sector. This in-container launcher patches tcb before
    # handing off: (1) open every libguestfs drive with blocksize=4096 so tcb can
    # read the 4K GPT; (2) size the output the way stock tcb would, copy the base
    # (partition layout preserved for genio-flash), grow its last (rootfs)
    # partition to that size with libguestfs, and let tcb reformat it — instead of
    # tcb's virt-resize step, an external 512-only tool that cannot read the 4K
    # disk, so container preloads larger than the base rootfs free space now fit.
    # The launcher goes inside the workdir that is already mounted, rather than
    # riding a bind mount of its own: a daemon that cannot resolve a -v source
    # silently substitutes an empty directory, which reaches python3 as a
    # directory and fails with a message about '__main__' instead of about the
    # mount. From /workdir the same condition yields "can't open file … [Errno 2]".
    local launcher
    launcher="$workdir/$LAUNCHER_NAME"
    cat > "$launcher" <<'PY'
import sys, os, shutil, subprocess, runpy
# /workdir is the launcher's own directory and holds the user's overlay trees,
# so drop it before importing anything the tool provides.
sys.path[:] = [p for p in sys.path if p not in ("", "/workdir")]
sys.path.insert(0, "/builder")
import guestfs
_orig_add = guestfs.GuestFS.add_drive_opts
def _add(self, filename, **kw):
    kw.setdefault("blocksize", 4096)
    return _orig_add(self, filename, **kw)
guestfs.GuestFS.add_drive_opts = _add
import tcbuilder.backend.dt          # import dt before deploy to break tcb's kernel<->dt cycle
import tcbuilder.backend.deploy as _deploy

SECTOR_SIZE = 4096

def _grow_last_partition(raw_img, added_size_kb, sector_size, rootfs_partition):
    # Ported from torizoncore-builder PR #156. The stock container lacks its
    # open_disk_image helper, so the handle is opened here (add_drive_opts above
    # forces blocksize=4096). shutdown() must commit the GPT edits before tcb
    # reopens the image to write the rootfs on a separate guestfs launch.
    new_size = os.path.getsize(raw_img) + int(added_size_kb) * 1024
    new_size = (new_size + sector_size - 1) // sector_size * sector_size
    subprocess.check_output(["truncate", "-s", str(new_size), raw_img])
    gfs = guestfs.GuestFS(python_return_dict=True)
    gfs.add_drive_opts(raw_img, format="raw")
    gfs.launch()
    try:
        dev = "/dev/sda"
        gfs.part_expand_gpt(dev)
        partnum = len(gfs.list_partitions())
        if gfs.part_to_partnum(rootfs_partition) != partnum:
            raise RuntimeError("rootfs must be the last partition to grow a 4Kn raw image")
        start_sector = gfs.part_list(dev)[-1]["part_start"] // sector_size
        name = gfs.part_get_name(dev, partnum)
        gpt_type = gfs.part_get_gpt_type(dev, partnum)
        gpt_guid = gfs.part_get_gpt_guid(dev, partnum)
        gpt_attrs = gfs.part_get_gpt_attributes(dev, partnum)   # carries the bootable bit
        gpt_tail = (33 * 512 + sector_size - 1) // sector_size  # GPT backup, 33 LBAs of 512 B
        end_sector = os.path.getsize(raw_img) // sector_size - 1 - gpt_tail
        gfs.part_del(dev, partnum)
        gfs.part_add(dev, "primary", start_sector, end_sector)
        gfs.part_set_name(dev, partnum, name)
        gfs.part_set_gpt_type(dev, partnum, gpt_type)
        gfs.part_set_gpt_guid(dev, partnum, gpt_guid)
        gfs.part_set_gpt_attributes(dev, partnum, gpt_attrs)
    finally:
        gfs.shutdown()
        gfs.close()

def _create_output_grow(base_raw_img, output_raw_img, base_rootfs_partition,
                        other_partitions_size_kb, rootfs_size_kb):
    # Ported from PR #156 create_output_raw_image (4Kn branch): size the output
    # exactly as stock tcb, copy the base, and grow the last partition with
    # libguestfs instead of the 512-only virt-resize. The stock caller passes no
    # sector_size, so SECTOR_SIZE is pinned here to always take the grow path.
    base_img_size_kb = os.path.getsize(base_raw_img) / 1024
    out_size_kb = max(base_img_size_kb,
                      _deploy.IMAGE_OVERHEAD_FACTOR * (rootfs_size_kb + other_partitions_size_kb))
    out_size_kb += _deploy.EXTRA_ROOTFS_SIZE_KB
    # A container bundle is tar_in'd into the rootfs after this sizing runs, so it
    # never enters rootfs_size_kb; the bridge measures the bundle up front and
    # passes a floor here so the grown partition has room for it. Without this the
    # grow is a no-op whenever the base image is already >= 2.3x its rootfs content.
    out_size_kb += float(os.environ.get("TCB_GENIO_BUNDLE_KB", "0"))
    shutil.copy2(base_raw_img, output_raw_img)
    if out_size_kb > base_img_size_kb:
        added_size_kb = out_size_kb - base_img_size_kb
        _grow_last_partition(output_raw_img, added_size_kb, SECTOR_SIZE, base_rootfs_partition)

_deploy.create_output_raw_image = _create_output_grow
sys.argv = ["torizoncore-builder"] + sys.argv[1:]
runpy.run_path("/builder/torizoncore-builder", run_name="__main__")
PY
    # tcb unpacks a scratch OS sysroot to a hard-coded /deploy (absent from the
    # image) — give it a throwaway volume there. $dind_args carries the host
    # Docker socket and --net=host, which only the container-preload path needs
    # (tcb spawns a docker-in-docker to fetch the images); hosts whose socket
    # lives elsewhere, such as rootless Docker, would otherwise be handed a
    # fabricated empty directory in its place on every run.
    docker run --rm \
        -e PYTHONDONTWRITEBYTECODE=1 \
        -e TCB_GENIO_BUNDLE_KB="${TCB_GENIO_BUNDLE_KB:-0}" \
        -v "$workdir":/workdir \
        -v tcb-genio-storage:/storage \
        -v /deploy \
        ${dind_args[@]+"${dind_args[@]}"} \
        --entrypoint python3 \
        "$TCB_IMAGE" "/workdir/$LAUNCHER_NAME" "$@"
}

# Measure an image's unpacked footprint, independent of the host's Docker image
# store. Two rungs, in order: export the flattened container filesystem (works
# on both stores), else sum the `docker save` layers, decompressing the gzip
# blobs the containerd store emits where the graphdriver store emits plain tars.
# Both yield an unpacked figure; there is deliberately no rung that returns a
# compressed one, because a compressed figure under-reserves the grow and is
# indistinguishable, to the caller, from a real measurement. If neither rung
# works the function returns 0, meaning "unmeasurable", and the caller reserves
# nothing rather than sizing from a fraction. Every step is guarded so the
# function never aborts under `set -euo pipefail`.
measure_unpacked_bytes() {
    local img=$1 plat=${2:-} sz=0 py cname

    # Preferred measure: the flattened filesystem of a container made from the
    # image. It is what the board actually stores, and it is the one figure both
    # image stores agree on. `docker save` cannot be relied on here: on a
    # containerd image store that has only the requested platform's content of a
    # multi-platform index, it refuses outright ("unable to create manifests
    # file: NotFound: content digest ... not found"), and the size ladder below
    # would then silently reserve nothing.
    local -a pargs=()
    if [ -n "$plat" ]; then pargs=(--platform "$plat"); fi
    cname=tcb-genio-measure-$$-$RANDOM
    # The trailing /bin/true is never executed — the container is only created —
    # but docker refuses to create one from an image that declares no CMD and no
    # ENTRYPOINT, which a data-only payload image legitimately does not.
    # measure_cname is global so the EXIT trap can reap the container if the
    # export, the longest step here, is interrupted.
    measure_cname=$cname
    if docker create ${pargs[@]+"${pargs[@]}"} --name "$cname" "$img" /bin/true >/dev/null 2>&1; then
        # An export that dies part way still exits wc successfully, and a short
        # count here would under-reserve exactly as the bug being fixed did, so
        # take the figure only when docker itself succeeded.
        sz=$(docker export "$cname" 2>/dev/null | wc -c; exit "${PIPESTATUS[0]}") || sz=0
        docker rm -f "$cname" >/dev/null 2>&1 || true
        measure_cname=
        sz=${sz//[[:space:]]/}; case $sz in ''|*[!0-9]*) sz=0 ;; esac
        if [ "${sz:-0}" -gt 0 ] 2>/dev/null; then
            echo "$sz"; return
        fi
    fi

    sz=0
    if command -v python3 >/dev/null 2>&1 && py=$(mktemp "${TMPDIR:-/tmp}/tcb-measure.XXXXXX"); then
        cat >"$py" <<'PY'
import sys, tarfile, gzip, io

CHUNK = 1 << 20

class _Prepend(io.RawIOBase):
    # Re-emit the peeked magic bytes, then delegate to the member stream.
    def __init__(self, head, rest):
        self._head, self._rest = head, rest
    def readable(self):
        return True
    def readinto(self, buf):
        if self._head:
            n = min(len(buf), len(self._head))
            buf[:n], self._head = self._head[:n], self._head[n:]
            return n
        return self._rest.readinto(buf)

def drain(f):
    n = 0
    while True:
        b = f.read(CHUNK)
        if not b:
            return n
        n += len(b)

total = 0
try:
    with tarfile.open(fileobj=sys.stdin.buffer, mode="r|") as tf:
        for m in tf:
            if not m.isfile():
                continue
            f = tf.extractfile(m)
            if f is None:
                continue
            head = f.read(2)
            if head == b"\x1f\x8b":          # gzip: compressed OCI layer blob
                total += drain(gzip.GzipFile(fileobj=io.BufferedReader(_Prepend(head, f))))
            else:                             # raw layer tar, or tiny metadata blob
                total += len(head) + drain(f)
except Exception:
    print(0)
    sys.exit(0)
print(total)
PY
        sz=$(docker save "$img" 2>/dev/null | python3 "$py") || sz=0
        rm -f "$py"
        sz=${sz//[[:space:]]/}; case $sz in ''|*[!0-9]*) sz=0 ;; esac
    fi
    if [ "${sz:-0}" -gt 0 ] 2>/dev/null; then
        echo "$sz"; return
    fi
    note "bundle sizing: cannot measure the unpacked size of $img on this host" >&2
    echo 0
}

# Measure the container bundle's on-disk size in KiB. tcb sizes the output image
# from the rootfs alone and tar_in's the bundle afterward, so a bundle-only
# customisation gets no grow unless we reserve room for it here. Pull each compose
# image at the target platform and sum its unpacked bytes (measure_unpacked_bytes,
# store-independent), plus a margin for docker-storage overhead and layer-dedup
# miscount. Best-effort: any failure returns 0 and the build proceeds exactly as
# before, with a warning.
measure_bundle_kb() {
    local yaml=$1 compose=$2
    [ -n "$compose" ] || { echo 0; return; }
    grep -qE '^[[:space:]]*bundle:[[:space:]]*$' "$yaml" || { echo 0; return; }

    local plat
    # assumes the config's only platform: key is the bundle block's
    plat=$(grep -E '^[[:space:]]*platform:[[:space:]]*' "$yaml" | head -1 \
           | sed -E 's/^[[:space:]]*platform:[[:space:]]*//; s/["'"'"']//g; s/[[:space:]]*$//') || true
    case $plat in
        linux/*) ;;                # literal target platform from the config
        *) plat=linux/arm64 ;;     # ${VAR} ref or unset: this board is arm64
    esac

    local imgs
    imgs=$(grep -E '^[[:space:]]*image:[[:space:]]*' "$compose" \
           | sed -E 's/^[[:space:]]*image:[[:space:]]*//; s/["'"'"']//g; s/[[:space:]]*$//') || true
    [ -n "$imgs" ] || { note "bundle sizing: no image in $compose; not reserving space" >&2; echo 0; return; }

    local total=0 img sz
    while IFS= read -r img; do
        [ -n "$img" ] || continue
        if ! docker pull --platform "$plat" "$img" >/dev/null 2>&1; then
            note "bundle sizing: cannot pull $img ($plat); output image may be too small for the bundle" >&2
            echo 0; return
        fi
        sz=$(measure_unpacked_bytes "$img" "$plat")
        # A zero here means every measure failed. Reserving the bare slack would
        # look like a sizing decision and then overflow the rootfs at tar_in, so
        # reserve nothing and say so, exactly as an unpullable image does.
        if [ "${sz:-0}" -le 0 ] 2>/dev/null; then
            note "bundle sizing: cannot measure $img; not reserving space (the bundle may not fit)" >&2
            echo 0; return
        fi
        total=$(( total + sz ))
    done <<< "$imgs"

    echo $(( total / 1024 * 11 / 10 + 65536 ))   # KiB, +10% overhead, +64 MiB slack
}

# Preflight every external tool so the run fails clean, not half-done.
for t in simg2img img2simg tar; do
    command -v "$t" >/dev/null 2>&1 \
        || die "'$t' not found on PATH (install android-sdk-libsparse-utils)"
done
command -v docker >/dev/null 2>&1 \
    || die "'docker' not found on PATH (needed to run torizoncore-builder)"
[ -f "$in_tar" ] || die "input tarball not found: $in_tar"
[ -f "$yaml" ]   || die "tcbuild config not found: $yaml"
# The ./changes default applies only when no -c was given; otherwise it would
# silently join the explicitly supplied set.
if [ "${#changes_dirs[@]}" -eq 0 ] && [ -d ./changes ]; then
    changes_dirs=(./changes)
fi
[ -n "$compose" ] || { [ -f ./docker-compose.yml ] && compose=./docker-compose.yml; }
for d in ${changes_dirs[@]+"${changes_dirs[@]}"}; do
    [ -d "$d" ] || die "changes directory not found: $d"
done
if [ -n "$compose" ]; then
    [ -f "$compose" ] || die "compose file not found: $compose"
fi

# Each -c is staged into the tcb workdir under its basename, so the basename must
# be a plain directory name: '-c .' would otherwise flatten the whole CWD into
# the workdir root, over the files staged below, and a leading '-' would reach cp
# as an option. A directory staged here but absent from the config's
# customization.filesystem list is simply not applied — the config decides.
staged_names=(input.wic output.wic tcbuild-genio.yaml "$LAUNCHER_NAME")
if [ -n "$compose" ]; then
    staged_names+=("$(basename "$compose")")
fi
seen_basenames=()
for d in ${changes_dirs[@]+"${changes_dirs[@]}"}; do
    b=$(basename "$d")
    case $b in
        .|..) die "invalid changes directory: $d" ;;
    esac
    [[ $b =~ ^[A-Za-z0-9._][A-Za-z0-9._-]*$ ]] \
        || die "invalid changes directory name '$b' (in $d): use letters, digits, '.', '_' or '-', not starting with '-'"
    for s in ${seen_basenames[@]+"${seen_basenames[@]}"}; do
        [ "$b" != "$s" ] || die "two changes directories share the name '$b'"
    done
    for s in "${staged_names[@]}"; do
        [ "$b" != "$s" ] || die "changes directory '$b' collides with a file the bridge stages"
    done
    seen_basenames+=("$b")
done

# -e VAR reaches tcb as --set VAR=<value>, the only substitution channel it has.
# Test the export attribute, not mere existence: plain existence would resolve
# this script's own variables. Set-but-empty is still forwarded as empty, since
# tcb's ${VAR:-d} and ${VAR-d} notations distinguish it from unset.
env_args=()
for v in ${env_vars[@]+"${env_vars[@]}"}; do
    [[ $v =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid variable name for -e: $v"
    [[ $(declare -p "$v" 2>/dev/null) == "declare -x "* ]] \
        || die "-e $v: variable is not set in the environment"
    env_args+=(--set "$v=${!v}")
done

if [ "$yaml_default" -eq 1 ] && [ "${#changes_dirs[@]}" -eq 0 ] && [ -z "$compose" ]; then
    # The shipped config takes files from ./changes and/or a container bundle
    # from ./docker-compose.yml; with neither there is nothing to customise.
    die "no customisation supplied: create ./changes (files) or ./docker-compose.yml (containers), or pass -c / -b"
fi
[ -n "$out" ] || out="${in_tar%.tar}-custom.tar"

# The working files go where the user is working, matching the mount Toradex's
# own torizoncore-builder wrapper uses; /tmp is a fallback, not the default,
# because a snap-confined daemon cannot see it. An explicit TMPDIR still wins.
# A candidate that is relative or holds a colon is skipped rather than refused:
# both break the -v argument, one silently (a relative source is read as a
# volume name).
for parent in ${TMPDIR:+"$TMPDIR"} "$PWD" /tmp; do
    parent=${parent%/}; [ -n "$parent" ] || parent=/
    case $parent in /*) ;; *) continue ;; esac
    case $parent in *:*) continue ;; esac
    work=$(mktemp -d "$parent/tcb-genio.XXXXXX" 2>/dev/null) && break
done
[ -n "${work:-}" ] || die "could not create a working directory in $PWD or /tmp"
# A cleanup failure must not fail a run that produced its tarball: tcb writes
# root-owned directories in here.
# INT/TERM as well as EXIT: an interrupt during the bundle measurement would
# otherwise leave the measurement container holding a writable layer that pins
# its image against docker rmi.
measure_cname=
cleanup() {
    [ -n "${measure_cname:-}" ] && docker rm -f "$measure_cname" >/dev/null 2>&1
    rm -rf "$work" 2>/dev/null || note "left behind: $work"
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM
[ "$work" = "$PWD/${work##*/}" ] || note "working files: $work"

# The socket and --net=host are wanted only when a preload is actually
# configured. Keyed on the config alone, not on a resolvable compose file: a
# custom config can name one the -c staging provides, in which case $compose is
# empty and the bundle still runs.
bundle_configured=0
grep -qE '^[[:space:]]*bundle:[[:space:]]*(#.*)?$' "$yaml" && bundle_configured=1
dind_args=()
sock=/var/run/docker.sock
case ${DOCKER_HOST-} in
    unix://?*) sock=${DOCKER_HOST#unix://} ;;
esac
if [ "$bundle_configured" = 1 ]; then
    dind_args=(-v "$sock":/var/run/docker.sock --net=host)
fi

if [ -z "${TCB_GENIO_SKIP_PREFLIGHT:-}" ]; then
    probe_workdir || exit 1
fi

# Size the bundle before the space check, not after: the output image, the
# re-sparsed image and the output tarball all grow with the bundle, so a check
# that knows only the input tarball is blind to the term that dominates at
# scale. (see measure_bundle_kb) The launcher adds this to tcb's rootfs-based
# sizing so the preload fits.
export TCB_GENIO_BUNDLE_KB
TCB_GENIO_BUNDLE_KB=$(measure_bundle_kb "$yaml" "$compose")
if [ "${TCB_GENIO_BUNDLE_KB:-0}" -gt 0 ] 2>/dev/null; then
    note "reserving $(( TCB_GENIO_BUNDLE_KB / 1024 )) MiB of image growth for the container bundle"
fi

if [ -z "${TCB_GENIO_SKIP_PREFLIGHT:-}" ]; then
    # Peak usage is the unpacked tarball plus the unsparsed input and output
    # images, plus the bundle carried in three of them: measured at ~10x the
    # tarball plus ~2x the bundle. A warning, not a refusal — the figure is an
    # estimate and a wrong one must not block a working run.
    avail_kb=$(df -Pk "$work" | awk 'NR==2 {print $4}')
    need_kb=$(( $(wc -c < "$in_tar") / 1024 * 10 + TCB_GENIO_BUNDLE_KB * 2 ))
    [ "${avail_kb:-0}" -ge "$need_kb" ] 2>/dev/null || msg_E "${avail_kb:-0}" "$need_kb"
fi

# 1. Unpack the genio-flash tarball (preserve xattrs as the build packed them).
note "unpacking $in_tar"
mkdir -p "$work/unpack"
tar --xattrs --xattrs-include='*' -C "$work/unpack" -xf "$in_tar"

mapfile -t sparse_imgs < <(find "$work/unpack" -name '*.wic.img' -type f)
[ "${#sparse_imgs[@]}" -ge 1 ] || die "no *.wic.img found inside $in_tar"
[ "${#sparse_imgs[@]}" -eq 1 ] || die "multiple *.wic.img found inside $in_tar; cannot pick one"
sparse=${sparse_imgs[0]}
note "system image: ${sparse#"$work"/unpack/}"

# 2. Unsparse the system image to a raw WIC inside the tcb working dir.
# Each overlay is staged under its own basename, which is how the config's
# customization.filesystem names it. With no -c, an empty changes/ is created
# instead (tcb errors on a filesystem: entry that does not exist), so the
# shipped config holds for a container-only customisation.
if [ "${#changes_dirs[@]}" -eq 0 ]; then
    mkdir -p "$work/tcb/changes"
else
    for d in "${changes_dirs[@]}"; do
        mkdir -p "$work/tcb/$(basename "$d")"
        cp -a -- "$d/." "$work/tcb/$(basename "$d")/"
    done
fi
# The bundle customisation reads its compose file from tcb's workdir; stage it
# under the basename the tcbuild config's bundle.compose-file references.
if [ -n "$compose" ]; then
    cp -a -- "$compose" "$work/tcb/$(basename "$compose")"
fi
cp -a "$yaml" "$work/tcb/tcbuild-genio.yaml"
note "unsparsing system image (simg2img)"
simg2img "$sparse" "$work/tcb/input.wic"

# 3. Run torizoncore-builder against the raw image. The raw-image input/output
#    blocks live in the YAML; tcb rewrites only the otaroot rootfs and copies
#    the bootloader partition through untouched.
# TCB_GENIO_BUNDLE_KB was measured and exported before the space check above.
note "running torizoncore-builder build"
# -e assignments first: tcb's parse_assignments lets the last --set win, so an
# explicit --set after -- overrides an -e of the same variable.
run_tcb "$work/tcb" build --file tcbuild-genio.yaml \
    ${env_args[@]+"${env_args[@]}"} ${tcb_args[@]+"${tcb_args[@]}"}
[ -f "$work/tcb/output.wic" ] || die "torizoncore-builder produced no output.wic"

# 4. Re-sparse with the build's 4096-byte block size, replacing the image in
#    place. android-sdk-libsparse-utils' img2simg takes the block size as a
#    positional 3rd argument, not a -b flag.
note "re-sparsing customised image (img2simg, 4096-byte blocks)"
img2simg "$work/tcb/output.wic" "$sparse" 4096

# 5. Repack the tarball; rity.json and the boot chain are untouched.
note "repacking $out"
tar --xattrs --xattrs-include='*' --numeric-owner -C "$work/unpack" -cf "$out" .

note "done: $out"
note "flash with: tar xf $(basename "$out") && cd <dir> && genio-flash system"
