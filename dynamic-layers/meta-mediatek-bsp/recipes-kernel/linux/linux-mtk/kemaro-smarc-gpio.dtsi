/* Kemaro carrier: name SMARC GPIO0..GPIO6 and leave them free for userspace.
 * pio60=CAM0_PWR#(GPIO0) pio59=CAM1_PWR#(GPIO1) pio57=CAM0_RST#(GPIO2)
 * pio58=CAM1_RST#(GPIO3) pio118=HDA_RST#(GPIO4) pio72=PWM_OUT(GPIO5)
 * pio119=TACHIN(GPIO6).
 *
 * Names only, deliberately: these pads are already ALT0=GPIO at reset and the
 * pin controller re-muxes a pad to GPIO when the line is requested, so a
 * pinmux group would add nothing an application needs. Anything that also
 * claims or pre-sets the lines takes them away from userspace or, as a
 * pinctrl default state on this node, risks failing the controller's probe.
 *
 * gpio-line-names is positional from offset 0, hence the leading blanks.
 *
 * TACHIN is a carrier fan-tach input on the ADLINK reference carrier: an
 * application driving pio119 there contends with the fan. Not an issue on the
 * Kemaro carrier, whose net list governs.
 *
 * Carrier-only; not part of the upstream Toradex port. */
&pio {
	gpio-line-names =
		/*   0.. 9 */ "", "", "", "", "", "", "", "", "", "",
		/*  10..19 */ "", "", "", "", "", "", "", "", "", "",
		/*  20..29 */ "", "", "", "", "", "", "", "", "", "",
		/*  30..39 */ "", "", "", "", "", "", "", "", "", "",
		/*  40..49 */ "", "", "", "", "", "", "", "", "", "",
		/*  50..56 */ "", "", "", "", "", "", "",
		/*  57..60 */ "kemaro-gpio2", "kemaro-gpio3", "kemaro-gpio1", "kemaro-gpio0",
		/*  61..71 */ "", "", "", "", "", "", "", "", "", "", "",
		/*      72 */ "kemaro-gpio5",
		/*  73..79 */ "", "", "", "", "", "", "",
		/*  80..89 */ "", "", "", "", "", "", "", "", "", "",
		/*  90..99 */ "", "", "", "", "", "", "", "", "", "",
		/* 100..109 */ "", "", "", "", "", "", "", "", "", "",
		/* 110..117 */ "", "", "", "", "", "", "", "",
		/*     118 */ "kemaro-gpio4",
		/*     119 */ "kemaro-gpio6";
};
