From 09ff6275d9bdf55151adcb9ddea49a5c1a6fe9dd Mon Sep 17 00:00:00 2001
From: Rogerio Guerra Borin <rogerio.borin@toradex.com>
Date: Thu, 27 Feb 2025 23:59:12 -0300
Subject: [PATCH] toradex: integrate shared secboot module (MediaTek)

Upstream-Status: Inappropriate [Torizon OS specific]

Signed-off-by: Rogerio Guerra Borin <rogerio.borin@toradex.com>
[Context refreshed for the MediaTek U-Boot 2022.10]
Signed-off-by: Vladimir Skvortsov <vskvortsov@emcraft.com>
---
 common/Makefile | 1 +
 1 file changed, 1 insertion(+)

diff --git a/common/Makefile b/common/Makefile
--- a/common/Makefile
+++ b/common/Makefile
@@ -22,6 +22,7 @@ obj-$(CONFIG_$(SPL_TPL_)OF_LIBFDT) += fdt_support.o
 obj-$(CONFIG_MII) += miiphyutil.o
 obj-$(CONFIG_CMD_MII) += miiphyutil.o
 obj-$(CONFIG_PHYLIB) += miiphyutil.o
+obj-y += tdx-secboot.o
 
 obj-$(CONFIG_USB_HOST) += usb.o usb_hub.o
 obj-$(CONFIG_USB_GADGET) += usb.o usb_hub.o
-- 
