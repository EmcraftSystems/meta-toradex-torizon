From: Vladimir Skvortsov <vskvortsov@emcraft.com>
Subject: [PATCH] tdx-enc: reuse one persistent TPM primary key

When the key blob is missing, as after every re-flash, the handler
persisted a new primary key at the next free handle and left the
previous one in the TPM. Keep the primary at one handle and reuse it.

Upstream-Status: Pending
Signed-off-by: Vladimir Skvortsov <vskvortsov@emcraft.com>
---
--- a/tdx-enc.sh	2026-11-13 16:44:20.636113386 +0100
+++ b/tdx-enc.sh	2026-11-13 16:44:20.648113122 +0100
@@ -17,6 +17,9 @@
 # encryption key location
 TDX_ENC_KEY_LOCATION="@@TDX_ENC_KEY_LOCATION@@"
 
+# persistent TPM handle of the primary key (TPM backend)
+TDX_ENC_TPM_HANDLE="@@TDX_ENC_TPM_HANDLE@@"
+
 # directory to store encrypted key
 TDX_ENC_KEY_DIR="@@TDX_ENC_KEY_DIR@@"
 
@@ -306,19 +309,30 @@
     tdx_enc_log "Setting up encryption key for TPM backend..."
 
     if [ ! -e "${TDX_ENC_KEY_FULLPATH}" ]; then
-        TPM_KEY_CTXT=$(mktemp /tmp/tdx-enc.XXXXXXXXXX)
+        TPMKEYHANDLE="${TDX_ENC_TPM_HANDLE}"
 
-        # create a private RSA key in the TPM
-        if ! tpm2_createprimary -C o -G rsa2048 -c "${TPM_KEY_CTXT}"; then
-            rm -f "${TPM_KEY_CTXT}"
-            tdx_enc_exit_error "Error creating a private RSA key in the TPM!"
-        fi
+        # reuse the primary key a previous installation left at the handle,
+        # rather than persisting one more on every re-flash
+        if TPM_PUB=$(tpm2_readpublic -c "${TPMKEYHANDLE}" 2>/dev/null); then
+            if ! echo "${TPM_PUB}" | grep -q "restricted|decrypt"; then
+                tdx_enc_exit_error "TPM handle ${TPMKEYHANDLE} holds a key that is not a storage key!"
+            fi
+            tdx_enc_log "Reusing the TPM primary key at ${TPMKEYHANDLE}..."
+        else
+            TPM_KEY_CTXT=$(mktemp /tmp/tdx-enc.XXXXXXXXXX)
 
-        # make the key persistent
-        TPMKEYHANDLE=$(tpm2_evictcontrol -C o -c "${TPM_KEY_CTXT}" | grep persistent-handle | cut -d' ' -f 2)
-        rm -f "${TPM_KEY_CTXT}"
-        if [ -z "$TPMKEYHANDLE" ]; then
-            tdx_enc_exit_error "Error making the TPM key persistent!"
+            # create a private RSA key in the TPM
+            if ! tpm2_createprimary -C o -G rsa2048 -c "${TPM_KEY_CTXT}"; then
+                rm -f "${TPM_KEY_CTXT}"
+                tdx_enc_exit_error "Error creating a private RSA key in the TPM!"
+            fi
+
+            # make the key persistent
+            if ! tpm2_evictcontrol -C o -c "${TPM_KEY_CTXT}" "${TPMKEYHANDLE}" >/dev/null; then
+                rm -f "${TPM_KEY_CTXT}"
+                tdx_enc_exit_error "Error making the TPM key persistent!"
+            fi
+            rm -f "${TPM_KEY_CTXT}"
         fi
     fi
 
