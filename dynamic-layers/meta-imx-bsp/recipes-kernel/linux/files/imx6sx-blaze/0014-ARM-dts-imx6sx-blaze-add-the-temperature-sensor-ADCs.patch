From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Vladimir Skvortsov <vskvortsov@emcraft.com>
Date: Mon, 19 Oct 2026 12:07:18 +0200
Subject: [PATCH] ARM: dts: imx6sx-blaze: add the temperature sensor, ADCs and
 FRAM

Describe the board's remaining I2C and analogue parts, each for a
mainline driver:

- the LM75ADP on I2C3 at 0x48, as national,lm75a: the LM75ADP is the
  LM75A in another package, and the lm75 driver has no use for its OS
  line;
- the TLA2024 on I2C4 at 0x48, for ti-ads1015, with no channel nodes,
  so all inputs are exposed at the default gain and data rate;
- the 16-kbit FRAM on I2C4 at 0x50, an FM24CL16B, as atmel,24c16;
- ADC2, with PERI_3V3, which feeds ADC_VREFH, as its reference.

Signed-off-by: Vladimir Skvortsov <vskvortsov@emcraft.com>
---
 arch/arm/boot/dts/nxp/imx/imx6sx-blaze.dts | 27 ++++++++++++++++++++--
 1 file changed, 25 insertions(+), 2 deletions(-)

diff --git a/arch/arm/boot/dts/nxp/imx/imx6sx-blaze.dts b/arch/arm/boot/dts/nxp/imx/imx6sx-blaze.dts
index f10da2b..cd70765 100644
--- a/arch/arm/boot/dts/nxp/imx/imx6sx-blaze.dts
+++ b/arch/arm/boot/dts/nxp/imx/imx6sx-blaze.dts
@@ -217,6 +217,12 @@
 	status = "disabled";
 };
 
+/* ADC_VREFH is fed from PERI_3V3. */
+&adc2 {
+	vref-supply = <&reg_peri_3v3>;
+	status = "okay";
+};
+
 &i2c1 {
 	clock-frequency = <100000>;
 	pinctrl-names = "default";
@@ -318,6 +324,12 @@
 	pinctrl-0 = <&pinctrl_i2c3>;
 	status = "okay";
 
+	/* An LM75ADP, the LM75A in another package; its OS line is not used. */
+	temperature-sensor@48 {
+		compatible = "national,lm75a";
+		reg = <0x48>;
+	};
+
 	rtc_i2c: rtc@51 {
 		compatible = "nxp,pcf85363";
 		reg = <0x51>;
@@ -326,8 +338,8 @@
 };
 
 /*
- * The panel's ST1633 touch controller. The FRAM, ADC and audio amplifier on
- * the same bus are not described.
+ * The TLA2024 ADC, the FRAM and the panel's ST1633 touch controller. The
+ * audio amplifier on the same bus is not described yet.
  */
 &i2c4 {
 	clock-frequency = <100000>;
@@ -335,6 +347,17 @@
 	pinctrl-0 = <&pinctrl_i2c4>;
 	status = "okay";
 
+	adc@48 {
+		compatible = "ti,tla2024";
+		reg = <0x48>;
+	};
+
+	/* A 16-kbit FRAM, FM24CL16B; it answers on 0x50 to 0x57. */
+	eeprom@50 {
+		compatible = "atmel,24c16";
+		reg = <0x50>;
+	};
+
 	touchscreen@70 {
 		compatible = "sitronix,st1633";
 		reg = <0x70>;
-- 
