From 126f3d5df6e31af7b5e87789a48c9f1053a84ab2 Mon Sep 17 00:00:00 2001
From: Dmitry Starchenko <dmitry.starchenko@emcraft.com>
Date: Thu, 15 Oct 2026 13:18:49 +0200
Subject: [PATCH] ARM: dts: imx6sx-blaze: add the TAS5756M audio

The speaker amplifier on I2C4 at 0x4d, with its card on SSI2 through AUDMUX
port 4, MCLK from the audio clock out on GPIO1_IO07, and the amplifier's mute,
fault and temperature pins. The card is a simple-audio-card named
tas5756-audio, the name the existing image uses, with SSI2 as the I2S provider.

The SSI2 clock tree needs no assignments: the i.MX6SX clock driver already
brings the PLL4 audio divider and the SSI2 divider to the 24.576 MHz base that
a 48 kHz bit clock is cut from.

Upstream-Status: Inappropriate [board-specific]
Signed-off-by: Dmitry Starchenko <dmitry.starchenko@emcraft.com>
---
 arch/arm/boot/dts/nxp/imx/imx6sx-blaze.dts | 71 ++++++++++++++++++++++
 1 file changed, 71 insertions(+)

diff --git a/arch/arm/boot/dts/nxp/imx/imx6sx-blaze.dts b/arch/arm/boot/dts/nxp/imx/imx6sx-blaze.dts
index f10da2bf4..d90435189 100644
--- a/arch/arm/boot/dts/nxp/imx/imx6sx-blaze.dts
+++ b/arch/arm/boot/dts/nxp/imx/imx6sx-blaze.dts
@@ -9,6 +9,7 @@
 
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/sound/fsl-imx-audmux.h>
 #include "imx6sx.dtsi"
 
 / {
@@ -162,6 +163,24 @@ reg_usb_otg2_vbus: regulator-usb-otg2-vbus {
 		gpio = <&gpio1 12 GPIO_ACTIVE_HIGH>;
 		enable-active-high;
 	};
+
+	/* SSI2 is the I2S provider; the codec's master clock is the audio clock out. */
+	sound {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "tas5756-audio";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,bitclock-master = <&sound_cpu>;
+		simple-audio-card,frame-master = <&sound_cpu>;
+
+		sound_cpu: simple-audio-card,cpu {
+			sound-dai = <&ssi2>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&codec>;
+			clocks = <&clks IMX6SX_CLK_AUDIO>;
+		};
+	};
 };
 
 &uart3 {
@@ -208,6 +227,37 @@ lvds-selb-hog {
 	};
 };
 
+/* AUDMUX ports are numbered from 1 in the manual and from 0 in the binding. */
+&audmux {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pinctrl_audmux>;
+	status = "okay";
+
+	mux-ssi2 {
+		fsl,audmux-port = <MX51_AUDMUX_PORT2_SSI1>;
+		fsl,port-config = <
+			IMX_AUDMUX_V2_PTCR_SYN
+			IMX_AUDMUX_V2_PDCR_RXDSEL(MX51_AUDMUX_PORT4)
+		>;
+	};
+
+	mux-aud4 {
+		fsl,audmux-port = <MX51_AUDMUX_PORT4>;
+		fsl,port-config = <
+			(IMX_AUDMUX_V2_PTCR_SYN |
+			IMX_AUDMUX_V2_PTCR_TFSDIR |
+			IMX_AUDMUX_V2_PTCR_TFSEL(MX51_AUDMUX_PORT2_SSI1) |
+			IMX_AUDMUX_V2_PTCR_TCLKDIR |
+			IMX_AUDMUX_V2_PTCR_TCSEL(MX51_AUDMUX_PORT2_SSI1))
+			IMX_AUDMUX_V2_PDCR_RXDSEL(MX51_AUDMUX_PORT2_SSI1)
+		>;
+	};
+};
+
+&ssi2 {
+	status = "okay";
+};
+
 &gpu {
 	status = "okay";
 };
@@ -344,6 +394,14 @@ touchscreen@70 {
 		interrupts = <14 IRQ_TYPE_EDGE_FALLING>;
 		gpios = <&gpio2 12 GPIO_ACTIVE_LOW>;
 	};
+
+	/* The amplifier's mute pin (AMP_MUTE_N) is active low. */
+	codec: audio-codec@4d {
+		compatible = "ti,tas5756";
+		reg = <0x4d>;
+		#sound-dai-cells = <0>;
+		amp-mute-gpios = <&gpio4 9 GPIO_ACTIVE_HIGH>;
+	};
 };
 
 /* The SNVS domain has no backup supply on this board. */
@@ -525,6 +583,19 @@ MX6SX_PAD_QSPI1B_SCLK__UART3_DCE_RX	0x1b0b1
 		>;
 	};
 
+	/* The three GPIO pads are the amplifier's mute, fault and temperature pins. */
+	pinctrl_audmux: audmuxgrp {
+		fsl,pins = <
+			MX6SX_PAD_NAND_CE0_B__AUDMUX_AUD4_TXC	0x13098
+			MX6SX_PAD_NAND_RE_B__AUDMUX_AUD4_TXFS	0x13088
+			MX6SX_PAD_NAND_CE1_B__AUDMUX_AUD4_TXD	0x12088
+			MX6SX_PAD_GPIO1_IO07__AUDMUX_MCLK	0x13088
+			MX6SX_PAD_GPIO1_IO04__GPIO1_IO_4	0x17059
+			MX6SX_PAD_NAND_DATA04__GPIO4_IO_8	0x17059
+			MX6SX_PAD_NAND_DATA05__GPIO4_IO_9	0x17059
+		>;
+	};
+
 	pinctrl_i2c1: i2c1grp {
 		fsl,pins = <
 			MX6SX_PAD_GPIO1_IO01__I2C1_SDA		0x4001b088
-- 
2.53.0

