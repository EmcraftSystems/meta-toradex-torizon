// SPDX-License-Identifier: GPL-2.0
/*
 * A custom i.MX6SoloX board.
 *
 * Display, touch, audio and CAN are on the board and not described yet. The
 * USB Wi-Fi adapters are out of scope; the on-board radio is below.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "imx6sx.dtsi"

/ {
	model = "Freescale i.MX6 SoloX Blaze Board";
	compatible = "fsl,imx6sx-blaze", "fsl,imx6sx";

	chosen {
		stdout-path = &uart3;
	};

	/*
	 * 512 MB. The board's existing tree says 1 GiB and is wrong.
	 */
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	reg_peri_3v3: regulator-peri-3v3 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_peri_3v3>;
		regulator-name = "peri_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio2 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		/*
		 * Feeds ENET, SD2, LVDS and BT. The enable has a pull-up, so
		 * the rail comes up on its own; this is what holds it.
		 */
		regulator-always-on;
		regulator-boot-on;
	};

	reg_enet_3v3: regulator-enet-3v3 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_enet_3v3>;
		regulator-name = "enet_3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio4 16 GPIO_ACTIVE_LOW>;
		vin-supply = <&reg_peri_3v3>;
		/*
		 * Without this the PHY latches its straps on a supply that is
		 * still ramping.
		 */
		startup-delay-us = <50000>;
	};

	/* The SD socket's 3V0 is switched on GPIO2_11, enable active high. */
	vcc_sd3: regulator-vcc-sd3 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_vcc_sd3>;
		regulator-name = "VCC_SD3";
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		gpio = <&gpio2 11 GPIO_ACTIVE_HIGH>;
		off-on-delay-us = <20000>;
		enable-active-high;
	};

	/*
	 * Not a rail. This is WLAN_EN on the Wi-Fi module, modelled as a
	 * regulator so the MMC core asserts it as usdhc2's vmmc and then waits
	 * out the module's power-up before the first SDIO command. The module
	 * itself is fed from PERI_3V3. The voltage is nominal — nothing reads
	 * it — but the delay is not: the part does not answer sooner.
	 */
	reg_wlan_en: regulator-wlan-en {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_wlan_en>;
		regulator-name = "wlan_en";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&gpio6 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <70000>;
	};

	reg_usb_otg1_vbus: regulator-usb-otg1-vbus {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_usb_otg1>;
		regulator-name = "usb_otg1_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio1 9 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_usb_otg2_vbus: regulator-usb-otg2-vbus {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_usb_otg2>;
		regulator-name = "usb_otg2_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio1 12 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};
};

&uart3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart3>;
	status = "okay";
};

&i2c1 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c1>;
	status = "okay";

	pmic: pfuze3000@8 {
		compatible = "fsl,pfuze3000";
		reg = <0x08>;

		regulators {
			sw1a_reg: sw1a {
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1475000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <6250>;
			};

			/* sw1c_reg label to align with pfuze100/pfuze200 */
			sw1c_reg: sw1b {
				regulator-min-microvolt = <700000>;
				regulator-max-microvolt = <1475000>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <6250>;
			};

			sw2_reg: sw2 {
				regulator-min-microvolt = <2500000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			sw3a_reg: sw3 {
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <1650000>;
				regulator-boot-on;
				regulator-always-on;
			};

			swbst_reg: swbst {
				regulator-min-microvolt = <5000000>;
				regulator-max-microvolt = <5150000>;
			};

			snvs_reg: vsnvs {
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <3000000>;
				regulator-boot-on;
				regulator-always-on;
			};

			vref_reg: vrefddr {
				regulator-boot-on;
				regulator-always-on;
			};

			vgen1_reg: vldo1 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
			};

			vgen2_reg: vldo2 {
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <1550000>;
			};

			vgen3_reg: vccsd {
				regulator-min-microvolt = <2850000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			vgen4_reg: v33 {
				regulator-min-microvolt = <2850000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};

			vgen5_reg: vldo3 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
			};

			vgen6_reg: vldo4 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
			};
		};
	};
};

/*
 * Micrel KSZ8081RNBIA on ENET1, MDIO address 1, RMII. The GPIO5_12 reset is
 * not optional: held asserted, the part never answers MDIO.
 */
&fec1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_enet1>;
	phy-supply = <&reg_enet_3v3>;
	phy-mode = "rmii";
	phy-handle = <&ethphy1>;

	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy1: ethernet-phy@1 {
			reg = <1>;
			micrel,led-mode = <1>;
			reset-gpios = <&gpio5 12 GPIO_ACTIVE_LOW>;
			reset-assert-us = <15000>;
			reset-deassert-us = <10000>;
		};
	};
};

/*
 * The reference design's low-power DDR timings corrupt this board's memory.
 * Nothing is lost by disabling it: the FEC pins BUS_FREQ_HIGH from probe
 * until suspend, so the low-power path is unreachable anyway.
 */
&{/soc/busfreq} {
	status = "disabled";
};

&usdhc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc1>;
	bus-width = <8>;
	non-removable;
	status = "okay";
};

/*
 * The Jorjin WG7833-B0 Wi-Fi module, SDIO only — its Bluetooth side is out of
 * scope. The part is a TI WL1833, which the driver's match table does not
 * name; every ti,wl18xx entry there selects the same wl18xx_data, and wl1835
 * is the one TI's own device trees use for this module.
 */
&usdhc2 {
	pinctrl-names = "default";
	/*
	 * The interrupt pad is muxed here, not on the wlcore node: that node is
	 * an SDIO function device the MMC core only creates once the card has
	 * enumerated, so pinctrl placed on it is applied too late to help the
	 * enumeration it depends on.
	 */
	pinctrl-0 = <&pinctrl_usdhc2 &pinctrl_wlan_irq>;
	bus-width = <4>;
	non-removable;
	no-1-8-v;
	keep-power-in-suspend;
	wakeup-source;
	cap-power-off-card;
	vmmc-supply = <&reg_wlan_en>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	wlcore@2 {
		compatible = "ti,wl1835";
		reg = <2>;
		interrupt-parent = <&gpio6>;
		interrupts = <16 IRQ_TYPE_EDGE_RISING>;
	};
};

/*
 * no-1-8-v: the socket is 3V0 only, and a card negotiating 1.8 V panics on
 * this hardware.
 */
&usdhc3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc3>;
	bus-width = <4>;
	no-1-8-v;
	vmmc-supply = <&vcc_sd3>;
	cd-gpios = <&gpio2 10 GPIO_ACTIVE_LOW>;
	status = "okay";
};

&usbotg1 {
	vbus-supply = <&reg_usb_otg1_vbus>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usb_otg1_id>, <&pinctrl_usb_otg1_oc>;
	over-current-active-low;
	status = "okay";
};

&usbotg2 {
	vbus-supply = <&reg_usb_otg2_vbus>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usb_otg2_oc>;
	dr_mode = "host";
	over-current-active-low;
	status = "okay";
};

&wdog1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_wdog>;
	fsl,ext-reset-output;
};

/* The PMIC supplies the cores directly; the anatop LDOs are bypassed. */
&reg_arm {
	vin-supply = <&sw1a_reg>;
	regulator-allow-bypass;
};

&reg_soc {
	vin-supply = <&sw1c_reg>;
	regulator-allow-bypass;
};

&iomuxc {
	pinctrl_uart3: uart3grp {
		fsl,pins = <
			MX6SX_PAD_QSPI1B_SS0_B__UART3_DCE_TX	0x1b0b1
			MX6SX_PAD_QSPI1B_SCLK__UART3_DCE_RX	0x1b0b1
		>;
	};

	pinctrl_i2c1: i2c1grp {
		fsl,pins = <
			MX6SX_PAD_GPIO1_IO01__I2C1_SDA		0x4001b088
			MX6SX_PAD_GPIO1_IO00__I2C1_SCL		0x4001b088
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX6SX_PAD_NAND_WP_B__USDHC1_RESET_B	0x17059
			MX6SX_PAD_SD1_CMD__USDHC1_CMD		0x17059
			MX6SX_PAD_SD1_CLK__USDHC1_CLK		0x10059
			MX6SX_PAD_SD1_DATA0__USDHC1_DATA0	0x17059
			MX6SX_PAD_SD1_DATA1__USDHC1_DATA1	0x17059
			MX6SX_PAD_SD1_DATA2__USDHC1_DATA2	0x17059
			MX6SX_PAD_SD1_DATA3__USDHC1_DATA3	0x17059
			MX6SX_PAD_NAND_DATA00__USDHC1_DATA4	0x17059
			MX6SX_PAD_NAND_DATA01__USDHC1_DATA5	0x17059
			MX6SX_PAD_NAND_DATA02__USDHC1_DATA6	0x17059
			MX6SX_PAD_NAND_DATA03__USDHC1_DATA7	0x17059
		>;
	};

	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			MX6SX_PAD_SD2_CMD__USDHC2_CMD		0x17061
			MX6SX_PAD_SD2_CLK__USDHC2_CLK		0x10071
			MX6SX_PAD_SD2_DATA0__USDHC2_DATA0	0x17061
			MX6SX_PAD_SD2_DATA1__USDHC2_DATA1	0x17061
			MX6SX_PAD_SD2_DATA2__USDHC2_DATA2	0x17061
			MX6SX_PAD_SD2_DATA3__USDHC2_DATA3	0x17061
		>;
	};

	pinctrl_usdhc3: usdhc3grp {
		fsl,pins = <
			MX6SX_PAD_SD3_CMD__USDHC3_CMD		0x17059
			MX6SX_PAD_SD3_CLK__USDHC3_CLK		0x10061
			MX6SX_PAD_SD3_DATA0__USDHC3_DATA0	0x17059
			MX6SX_PAD_SD3_DATA1__USDHC3_DATA1	0x17059
			MX6SX_PAD_SD3_DATA2__USDHC3_DATA2	0x17059
			MX6SX_PAD_SD3_DATA3__USDHC3_DATA3	0x17059
			MX6SX_PAD_KEY_COL0__GPIO2_IO_10		0x17059
		>;
	};

	pinctrl_vcc_sd3: vccsd3grp {
		fsl,pins = <
			MX6SX_PAD_KEY_COL1__GPIO2_IO_11		0x17059
		>;
	};

	pinctrl_wlan_en: wlanengrp {
		fsl,pins = <
			MX6SX_PAD_SD4_DATA1__GPIO6_IO_15	0x17059
		>;
	};

	pinctrl_wlan_irq: wlanirqgrp {
		fsl,pins = <
			MX6SX_PAD_SD4_DATA2__GPIO6_IO_16	0x13059
		>;
	};

	pinctrl_wdog: wdoggrp {
		fsl,pins = <
			MX6SX_PAD_GPIO1_IO13__WDOG1_WDOG_ANY	0x30b0
		>;
	};

	pinctrl_enet1: enet1grp {
		fsl,pins = <
			MX6SX_PAD_ENET1_MDIO__ENET1_MDIO		0xa0b1
			MX6SX_PAD_ENET1_MDC__ENET1_MDC			0xa0b1
			MX6SX_PAD_RGMII1_TD0__ENET1_TX_DATA_0		0xa0b1
			MX6SX_PAD_RGMII1_TD1__ENET1_TX_DATA_1		0xa0b1
			MX6SX_PAD_RGMII1_TX_CTL__ENET1_TX_EN		0xa0b1
			MX6SX_PAD_RGMII1_RXC__ENET1_RX_ER		0x3081
			MX6SX_PAD_RGMII1_RD0__ENET1_RX_DATA_0		0x3081
			MX6SX_PAD_RGMII1_RD1__ENET1_RX_DATA_1		0x3081
			MX6SX_PAD_RGMII1_RX_CTL__ENET1_RX_EN		0x3081
			MX6SX_PAD_ENET1_TX_CLK__ENET1_REF_CLK1		0x91
			MX6SX_PAD_ENET1_RX_CLK__ENET1_REF_CLK_25M	0x91
			MX6SX_PAD_RGMII1_TD2__GPIO5_IO_8		0x80000000
			MX6SX_PAD_RGMII2_RD0__GPIO5_IO_12		0x80000000
		>;
	};

	pinctrl_enet_3v3: enet3v3grp {
		fsl,pins = <
			MX6SX_PAD_QSPI1A_DATA0__GPIO4_IO_16	0x80000000
		>;
	};

	pinctrl_peri_3v3: peri3v3grp {
		fsl,pins = <
			MX6SX_PAD_KEY_ROW0__GPIO2_IO_15		0x80000000
		>;
	};
	pinctrl_usb_otg1: usbotg1grp {
		fsl,pins = <
			MX6SX_PAD_GPIO1_IO09__GPIO1_IO_9	0x10b0
		>;
	};

	pinctrl_usb_otg1_oc: usbotg1ocgrp {
		fsl,pins = <
			MX6SX_PAD_GPIO1_IO08__USB_OTG1_OC	0x17059
		>;
	};

	pinctrl_usb_otg1_id: usbotg1idgrp {
		fsl,pins = <
			MX6SX_PAD_GPIO1_IO10__ANATOP_OTG1_ID	0x17059
		>;
	};

	pinctrl_usb_otg2: usbotg2grp {
		fsl,pins = <
			MX6SX_PAD_GPIO1_IO12__GPIO1_IO_12	0x10b0
		>;
	};

	pinctrl_usb_otg2_oc: usbotg2ocgrp {
		fsl,pins = <
			MX6SX_PAD_GPIO1_IO11__USB_OTG2_OC	0x17059
		>;
	};

};
