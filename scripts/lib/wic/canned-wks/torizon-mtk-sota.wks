# short-description: OTA-enabled OSTree image for MediaTek Genio (A/B bootloader + single rootfs)
# long-description: GPT image for the genio-flash flow in Torizon's OSTree layout:
# two raw FIP partitions (A/B), the boot-control partition BL2 and U-Boot select
# the FIP slot from, and a single ext4 partition carrying the OSTree sysroot (no
# /boot partition - kernel/DTB/initramfs live in the OSTree deployment).
# BL2 and U-Boot find the partitions by name.

bootloader --ptable gpt --timeout=0
part --source rawcopy --sourceparams="file=fip.bin" --part-name bootloaders --align 512 --fixed-size 4M
part --source rawcopy --sourceparams="file=fip.bin" --part-name bootloaders_b --align 512 --fixed-size 4M
# Written as data, not left as a hole, so the sparse flash image clears a stale
# boot-control record; BL2 initialises a zeroed one to slot A.
part --source rawcopy --sourceparams="file=misc-zero.bin" --part-name misc --align 512 --fixed-size 1M
# --active marks the rootfs bootable; the distro_bootcmd scan keys off that flag,
# not the partition index, so the rootfs is found here at partition 4.
part / --source otaimage --fstype=ext4 --part-name rootfs --align 4096 --use-uuid --active
