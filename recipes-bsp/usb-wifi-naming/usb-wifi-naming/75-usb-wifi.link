# Catch-all for adapters below the module's own sockets. net_id emits no
# host-controller component for a device-tree platform xHCI, so two of them at
# the same port index collide; name from the MAC, path last because a first
# match here means 99-default.link is never reached. No path altname — it would
# park the name a later adapter has to rename onto.

[Match]
Type=wlan
Property=ID_BUS=usb

[Link]
NamePolicy=keep kernel database onboard slot mac path
AlternativeNamesPolicy=database onboard slot
MACAddressPolicy=persistent
