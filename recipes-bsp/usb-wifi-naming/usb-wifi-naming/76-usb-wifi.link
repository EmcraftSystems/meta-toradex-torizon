# Catch-all behind the per-socket files, for an adapter they cannot reach — one
# on a carrier-side hub. net_id emits no host-controller component for a
# device-tree platform xHCI, so two such adapters at the same port index on two
# controllers compute the same name and the second rename fails EEXIST. Name
# from the MAC; keep path after it, because a first match here means
# 99-default.link is never consulted and mac yields nothing for an adapter whose
# address is not permanent. No path altname: it would park the very name such an
# adapter then has to rename onto.

[Match]
Type=wlan
Property=ID_BUS=usb

[Link]
NamePolicy=keep kernel database onboard slot mac path
AlternativeNamesPolicy=database onboard slot
MACAddressPolicy=persistent
